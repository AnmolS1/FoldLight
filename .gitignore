# Xcode / build
ios/build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcscmblueprint
# Ignore generated docs, but keep the checked-in accessibility contrast reference.
# (A bare `!docs/ACCESSIBILITY_CONTRAST.md` can't re-include a file whose parent
# dir is excluded, so the directory itself must be listed as `docs/*`.)
docs/*
!docs/ACCESSIBILITY_CONTRAST.md

# XcodeGen output (regenerate with `xcodegen generate`)
ios/FoldLight.xcodeproj/

# App Store listing screenshots — regenerate with scripts/screenshots/, upload via
# App Store Connect. Not needed in the repo.
fastlane/

# macOS
.DS_Store

# Session tooling / scratch
.remember/

# Secrets — never commit tokens
*.env
.env